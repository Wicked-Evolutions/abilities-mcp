{
  "defaultSite": "mysite",
  "sites": {
    "mysite": {
      "label": "My WordPress Site",
      "url": "https://example.com",
      "transport": "http",
      "http": {
        "endpoint": "https://example.com/wp-json/mcp/abilities-mcp-adapter-default-server",
        "username": "mcp-agent",
        "passwordCommand": "security find-generic-password -a mcp-agent -s example.com -w"
      }
    },
    "staging": {
      "label": "Staging Site",
      "url": "https://staging.example.com",
      "transport": "http",
      "http": {
        "endpoint": "https://staging.example.com/wp-json/mcp/abilities-mcp-adapter-default-server",
        "username": "mcp-agent",
        "password": "xxxx xxxx xxxx xxxx"
      }
    },
    "legacy-ssh": {
      "label": "SSH Site (legacy transport)",
      "transport": "ssh",
      "ssh": {
        "host": "my-ssh-host",
        "path": "~/public_html",
        "user": "wpaiagent"
      }
    },
    "network": {
      "label": "WordPress Multisite",
      "url": "https://network.example.com",
      "transport": "http",
      "http": {
        "endpoint": "https://network.example.com/wp-json/mcp/abilities-mcp-adapter-default-server",
        "username": "mcp-agent",
        "passwordEnv": "WP_NETWORK_PASSWORD"
      },
      "multisite": {
        "main": "https://network.example.com/",
        "blog": "https://blog.network.example.com/",
        "shop": "https://shop.network.example.com/"
      }
    }
  }
}
